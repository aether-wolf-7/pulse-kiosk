# Copy to .env and fill in.
#
# Defaults are production-safe: with no .env at all the app runs with
# DEBUG=False and refuses to start without SECRET_KEY and
# HEVY_KEY_ENCRYPTION_KEY. Local development must opt in explicitly.

# --- local development ---
# DEBUG=True
# SECRET_KEY=dev-only-insecure-key
# (with DEBUG=True the Hevy encryption key is auto-generated once into
#  backend/.dev-fernet-key, which is gitignored and machine-local)

# --- production (all required) ---
# DEBUG=False
# SECRET_KEY=<50+ random chars, unique per environment>
# ALLOWED_HOSTS=api.seudominio.com.br
# DATABASE_URL=postgres://user:pass@host:5432/pulsekiosk
# Fernet key for Hevy API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored Hevy key undecryptable (students must re-link).
# HEVY_KEY_ENCRYPTION_KEY=

# --- optional ---
# HEVY_API_BASE_URL=https://api.hevyapp.com
# LOGIN_FAILURE_LIMIT=10
# LOGIN_FAILURE_WINDOW_MINUTES=15
