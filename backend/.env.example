# Copy to .env and fill in. Local dev works with all defaults (SQLite + dev crypto key).

# DEBUG=True
# SECRET_KEY=change-me
# ALLOWED_HOSTS=localhost,127.0.0.1

# Production database (PostgreSQL):
# DATABASE_URL=postgres://user:pass@host:5432/pulsekiosk

# Fernet key for Hevy API keys at rest. REQUIRED in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HEVY_KEY_ENCRYPTION_KEY=

# HEVY_API_BASE_URL=https://api.hevyapp.com
