# Copy to deploy/.env on the server and fill in. NEVER commit the real file.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"                      # SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # HEVY_KEY_ENCRYPTION_KEY

DOMAIN=kiosk.pulsefitness.com.br
ACME_EMAIL=

SECRET_KEY=

# Encrypts every student's Hevy API key at rest.
# If this is lost, no stored key can be read again and every student has to
# link their Hevy account from scratch. Keep a copy somewhere that is NOT
# this VPS, and do not rotate it casually.
HEVY_KEY_ENCRYPTION_KEY=

POSTGRES_DB=pulsekiosk
POSTGRES_USER=pulsekiosk
POSTGRES_PASSWORD=
